<mxfile host="app.diagrams.net" modified="2026-10-16T00:00:00.000Z" agent="architecture-continuum" version="24.0.0" type="device" compressed="false">
  <diagram id="continuum" name="The continuum">
    <mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t1" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;The continuum: from the platform landscape to a deployable unit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5a6a86&quot;&gt;Problem space says who owns what and what must be possible. Solution space says how it is structured and built. Runtime says what runs where.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;" vertex="1" parent="1"><mxGeometry x="24" y="10" width="1200" height="50" as="geometry"/></mxCell>
        <mxCell id="3" value="PROBLEM SPACE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EEF2FB;" vertex="1" parent="1"><mxGeometry x="20" y="66" width="1360" height="222" as="geometry"/></mxCell>
        <mxCell id="4" value="SOLUTION SPACE" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EDF7F4;" vertex="1" parent="1"><mxGeometry x="20" y="292" width="1360" height="214" as="geometry"/></mxCell>
        <mxCell id="5" value="RUNTIME" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF4E8;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="1360" height="150" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;b&gt;Platform landscape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Layers of platforms: which exist, and which depends on which&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="7" value="&lt;b&gt;Platform&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;PL-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Team-owned, self-service unit of capability. Who owns and provides it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="152" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="8" value="&lt;b&gt;Capability&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;CAP-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;What must be possible, independent of how. Maturity and rung&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="224" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="9" value="&lt;b&gt;Bounded context&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;BC-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Where one model and one language hold. Not a deployment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="296" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="10" value="&lt;b&gt;Architecture building block&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;ABB-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Logical, technology-agnostic, published interfaces. What must exist&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="368" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="11" value="&lt;b&gt;Solution building block&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;SBB-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Named technologies realising an ABB. What we chose to build or buy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;Service, the deployable unit&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;SV-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;The C4 container that runs code: released and deployed on its own&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="512" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Deployment node&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;DN-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Account, region, runtime, scaling, run-as identity. Where it runs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="480" y="584" width="400" height="52" as="geometry"/></mxCell>
        <mxCell id="14" value="holds, in layers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="15" value="provides" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="16" value="realised by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="8" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="17" value="contains" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="9" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="18" value="realised by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="19" value="realised by" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="20" value="deployed to" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="21" value="&lt;b&gt;Outcome&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;OC-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;A measurable business result. Why&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="152" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="22" value="&lt;b&gt;Use case&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;UC-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Behaviour giving an actor a result of value&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="224" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="23" value="&lt;b&gt;Domain and subdomain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Problem space. A subdomain maps to one bounded context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="296" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="24" value="&lt;b&gt;Product&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;PRD-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Offered by a platform; requires capabilities. Runs a workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="512" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="25" value="&lt;b&gt;Module and component&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Code inside a service: domain, ports, adapters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="70" y="584" width="340" height="52" as="geometry"/></mxCell>
        <mxCell id="26" value="owned by" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="21" target="7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="27" value="requires" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.85;entryX=0;entryY=0.4;" edge="1" parent="1" source="21" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="28" value="supports" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="22" target="21"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="29" value="maps to" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="23" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="runs" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="24" target="12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="31" value="contains" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.9;entryX=1;entryY=0.25;" edge="1" parent="1" source="12" target="25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="32" value="&lt;b&gt;Consideration and decision record&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;CN-NNN, DR-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;An open question with more than one credible answer, and its settlement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="950" y="80" width="420" height="52" as="geometry"/></mxCell>
        <mxCell id="33" value="&lt;b&gt;Contracts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Interfaces, APIs and events, published from the owning context&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="950" y="152" width="420" height="52" as="geometry"/></mxCell>
        <mxCell id="34" value="&lt;b&gt;Pattern&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;PAT-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Blocks, interfaces, scenarios. Scope is declared; abstraction is derived&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7FA;strokeColor=#5A6A86;strokeWidth=1.2;dashed=1;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="950" y="296" width="420" height="210" as="geometry"/></mxCell>
        <mxCell id="35" value="&lt;b&gt;Architecture pattern&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;ABBs and local roles. Logical. Technology-agnostic&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="970" y="350" width="384" height="48" as="geometry"/></mxCell>
        <mxCell id="36" value="&lt;b&gt;Reference architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;SBBs and technologies. Physical. Applies architecture patterns&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="970" y="446" width="384" height="48" as="geometry"/></mxCell>
        <mxCell id="37" value="&lt;b&gt;Store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;A database, bucket or table owned by one context. A Backstage resource&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6A86;strokeWidth=1.2;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="950" y="584" width="420" height="52" as="geometry"/></mxCell>
        <mxCell id="38" value="affects" style="edgeStyle=none;rounded=1;html=1;strokeColor=#8A94A6;strokeWidth=1.2;dashed=1;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.9;entryX=1;entryY=0.25;" edge="1" parent="1" source="32" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="39" value="between contexts" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.9;entryX=1;entryY=0.35;" edge="1" parent="1" source="33" target="9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="40" value="realises" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.04;entryX=1;entryY=0.55;" edge="1" parent="1" source="34" target="8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="41" value="composes" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.6;entryX=1;entryY=0.45;" edge="1" parent="1" source="35" target="10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="42" value="composes" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="36" target="11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="43" value="applies" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="36" target="35"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="44" value="owns" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.65;entryX=0;entryY=0.3;" edge="1" parent="1" source="12" target="37"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="45" value="hosted on" style="edgeStyle=none;rounded=1;html=1;strokeColor=#3A4A66;strokeWidth=1.3;fontColor=#3A4A66;fontSize=11;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.75;entryX=1;entryY=0.75;" edge="1" parent="1" source="37" target="13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="leg" value="&lt;b&gt;Reading the picture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;The spine is the golden thread: Outcome, Platform, Capability, Bounded context, ABB, SBB, Service, extended here with the landscape above it and the node below it.&lt;br&gt;Platform is the unit of ownership and consumption; domain is the problem space it serves. The two usually coincide and are never the same thing.&lt;br&gt;An ABB lives inside one bounded context: this bundle's rule, where TOGAF leaves a block enterprise-wide. Reuse is through a pattern that names it, or a cross-cutting platform.&lt;br&gt;Architecture pattern and reference architecture are two types of one construct (Kruchten, Bass). A pattern's abstraction is read from its boxes; the ladder reads it: R3 logical, R4 physical.&lt;br&gt;A service is the C4 container that executes code: separately built, versioned, released and deployed, inside one bounded context, run by a product, deployed to nodes.&lt;br&gt;Own conventions: the rung, the consideration, product runs service, store as a resource (as Backstage). The rest: TOGAF 10, O-AA, DDD, Team Topologies, CNCF, C4, Backstage, ArchiMate 3.2, the cloud Well-Architected frameworks.&lt;br&gt;Solid arrow: a relationship recorded in front matter. Dashed arrow: may point at any level.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6DAE3;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="680" width="1360" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
