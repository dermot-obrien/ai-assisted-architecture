  <diagram id="continuum" name="The continuum">
    <mxGraphModel dx="1704" dy="895" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;The continuum: from the platform landscape to a deployable unit&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#5a6a86&quot;&gt;Problem space says who owns what and what must be possible. Solution space says how it is structured and built. Runtime says what runs where.&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="1200" x="24" y="10" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EEF2FB;" value="PROBLEM SPACE" vertex="1">
          <mxGeometry height="222" width="1360" x="20" y="66" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#EDF7F4;" value="SOLUTION SPACE" vertex="1">
          <mxGeometry height="248" width="1360" x="20" y="298" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFF4E8;" value="RUNTIME" vertex="1">
          <mxGeometry height="180" width="1360" x="20" y="554" as="geometry" />
        </mxCell>
        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" value="&lt;b&gt;Platform landscape&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Layers of platforms: which exist, and which depends on which&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="400" x="480" y="80" as="geometry" />
        </mxCell>
        <mxCell id="7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" value="&lt;b&gt;Platform&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;PL-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Team-owned, self-service unit of capability. Who owns and provides it&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="400" x="480" y="152" as="geometry" />
        </mxCell>
        <mxCell id="8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" value="&lt;b&gt;Capability&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;CAP-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;What must be possible, independent of how. Maturity and rung&lt;/font&gt;" vertex="1">
          <mxGeometry height="52" width="400" x="480" y="224" as="geometry" />
        </mxCell>
        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" value="&lt;b&gt;Bounded context&lt;/b&gt; &lt;font color=&quot;#2a4cdb&quot; face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;BC-NNN&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Where one model and one language hold. Not a deployment&lt;/font&gt;" vertex="1">
