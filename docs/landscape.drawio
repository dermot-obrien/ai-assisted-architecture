<mxfile host="app.diagrams.net" agent="architecture-continuum" compressed="false">
  <diagram id="landscape" name="The skill bundles">
    <mxGraphModel dx="1790" dy="941" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="band-L4" value="&lt;b&gt;L4 SOLUTIONS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#FFF4E8" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1360" height="122" as="geometry"/></mxCell>
        <mxCell id="band-L3" value="&lt;b&gt;L3 SCAFFOLDING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#F3F0FB" vertex="1" parent="1"><mxGeometry x="20" y="200" width="1360" height="122" as="geometry"/></mxCell>
        <mxCell id="band-L2" value="&lt;b&gt;L2 CATALOGUE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#EDF7F4" vertex="1" parent="1"><mxGeometry x="20" y="330" width="1360" height="142" as="geometry"/></mxCell>
        <mxCell id="band-L1" value="&lt;b&gt;L1 METHOD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#EEF2FB" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1360" height="142" as="geometry"/></mxCell>
        <mxCell id="band-L0" value="&lt;b&gt;L0 FOUNDATIONS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;fontColor=#5A6A86;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=5;fillColor=#F3F4F7" vertex="1" parent="1"><mxGeometry x="20" y="630" width="1360" height="120" as="geometry"/></mxCell>
        <mxCell id="t1" value="&lt;b&gt;&lt;font style=&quot;font-size:18px&quot;&gt;The skill bundles: what exists, what is needed, and how they depend on each other&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;Dependencies point down only. Each skill is complete on its own; a repository composes the bundles it wants in .agents/skills.json and answers each skill's bindings in .agents/skill-bindings.toml.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="3" width="1340" height="50" as="geometry"/></mxCell>
        <mxCell id="4" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;Repositories that install bundles and bind them, in one of two styles: an architecture repository of its own beside an implementation, or the architecture under docs/ of the component's own repository.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="92" width="172" height="96" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;Needed. Scaffolds or validates a solution's architecture against the continuum, composes the bundles below into it, and keeps the architecture and the implementation aligned.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="222" width="172" height="96" as="geometry"/></mxCell>
        <mxCell id="8" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;The architecture artefacts and their definitions, from the platform landscape to the deployment node.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="352" width="172" height="116" as="geometry"/></mxCell>
        <mxCell id="10" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;How work, research, patterns and planning are done. Each stands alone.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="502" width="172" height="116" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#5a6a86&quot;&gt;The installer and bundle format, the diagram model and the deck renderer.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="24" y="652" width="172" height="94" as="geometry"/></mxCell>
        <mxCell id="pa" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;patternode-architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;patternode/patternode-architecture&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Style A, the exemplar: an architecture repository of its own. The house profile; implementation links back.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="pp" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;patternode-platform&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;patternode/patternode-platform&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Implementation: hexagonal contexts, linking back to the architecture. Two repository-local skills.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="442" y="90" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="ks" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;knowledge-store&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;patternode/knowledge-store&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Style B, a standalone component: the architecture under docs/ in its own repository, expressed with the continuum first.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="674" y="90" width="232" height="92" as="geometry"/></mxCell>
        <mxCell id="lg" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;life-guide-internal&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;patternode/life-guide-internal&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Style B today, informally: architecture documents beside the implementation. Installs work and thread only.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="918" y="90" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="nx" value="&lt;b&gt;&lt;font color=&quot;#2A4CDB&quot;&gt;The next solution&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;either style&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Scaffolded from the house profile, aligned by construction, kept aligned by reconcile.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontColor=#2A4CDB;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1150" y="90" width="225" height="92" as="geometry"/></mxCell>
        <mxCell id="sa" value="&lt;b&gt;&lt;font color=&quot;#2A4CDB&quot;&gt;scaffold-architecture&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Scaffolds or validates an architecture that conforms to the continuum, in a repository of its own or under docs/ of a component's repository: folders by level, bindings, skills.json, registers, the site. The profile comes from the exemplar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontColor=#2A4CDB;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="210" y="220" width="380" height="92" as="geometry"/></mxCell>
        <mxCell id="si" value="&lt;b&gt;&lt;font color=&quot;#2A4CDB&quot;&gt;scaffold-implementation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Contexts and services from the catalogue in, a hexagonal skeleton out: contract, domain, adapters, service module, one composition root per deployable. Java or Python.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontColor=#2A4CDB;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="606" y="220" width="370" height="92" as="geometry"/></mxCell>
        <mxCell id="rc" value="&lt;b&gt;&lt;font color=&quot;#2A4CDB&quot;&gt;reconcile&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Architecture against implementation, both ways: contexts, services, contracts and nodes. A drift report, run in CI, that fails when a deployable has no catalogue entry.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1.4;dashed=1;dashPattern=6 3;fontColor=#2A4CDB;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="992" y="220" width="383" height="92" as="geometry"/></mxCell>
        <mxCell id="ac" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;architecture-continuum&lt;/font&gt;&lt;/b&gt; &lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;dermot-obrien/architecture-continuum&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;One skill, &lt;font face=&quot;Consolas&quot;&gt;architecture&lt;/font&gt;, with a flow per construct; today nine &lt;font face=&quot;Consolas&quot;&gt;aaa-*&lt;/font&gt; skills, folded into it under the rename. Carries the continuum (docs/continuum.md), the standards each flow reads, the front matter schemas, the architecture ontology, which extends the work ontology, and the definition ladder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="210" y="350" width="1165" height="108" as="geometry"/></mxCell>
        <mxCell id="22" value="strategy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="222" y="408" width="70" height="20" as="geometry"/></mxCell>
        <mxCell id="23" value="platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="298" y="408" width="70" height="20" as="geometry"/></mxCell>
        <mxCell id="24" value="capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="374" y="408" width="80" height="20" as="geometry"/></mxCell>
        <mxCell id="25" value="context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="460" y="408" width="66" height="20" as="geometry"/></mxCell>
        <mxCell id="26" value="abb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="532" y="408" width="46" height="20" as="geometry"/></mxCell>
        <mxCell id="27" value="sbb" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="584" y="408" width="46" height="20" as="geometry"/></mxCell>
        <mxCell id="28" value="service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="636" y="408" width="62" height="20" as="geometry"/></mxCell>
        <mxCell id="29" value="runtime-agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="704" y="408" width="100" height="20" as="geometry"/></mxCell>
        <mxCell id="30" value="rung" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="810" y="408" width="50" height="20" as="geometry"/></mxCell>
        <mxCell id="31" value="product" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1;dashed=1;dashPattern=4 2;fontColor=#2A4CDB;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="866" y="408" width="68" height="20" as="geometry"/></mxCell>
        <mxCell id="32" value="node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1;dashed=1;dashPattern=4 2;fontColor=#2A4CDB;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="940" y="408" width="50" height="20" as="geometry"/></mxCell>
        <mxCell id="33" value="landscape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A4CDB;strokeWidth=1;dashed=1;dashPattern=4 2;fontColor=#2A4CDB;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="996" y="408" width="78" height="20" as="geometry"/></mxCell>
        <mxCell id="34" value="&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Flows that exist, and three needed: product, the offering a team runs and its features; node, where a service runs; landscape, the layers of platforms.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontColor=#1B2A4A;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1084" y="406" width="280" height="40" as="geometry"/></mxCell>
        <mxCell id="ap" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;architecture-pattern&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;dermot-obrien/architecture-pattern&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;One document is the model and the deck. Patterns at any scope; types optional.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="210" y="500" width="280" height="108" as="geometry"/></mxCell>
        <mxCell id="36" value="pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="222" y="546" width="60" height="20" as="geometry"/></mxCell>
        <mxCell id="37" value="use-case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="288" y="546" width="66" height="20" as="geometry"/></mxCell>
        <mxCell id="38" value="cross-reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="360" y="546" width="108" height="20" as="geometry"/></mxCell>
        <mxCell id="dp" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;delivery-planning&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;dermot-obrien/delivery-planning&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Plans a quarter from the registers and the ladder.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="505" y="500" width="160" height="108" as="geometry"/></mxCell>
        <mxCell id="40" value="quarter-planning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="517" y="546" width="116" height="20" as="geometry"/></mxCell>
        <mxCell id="ar" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;ai-assisted-research&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;dermot-obrien/ai-assisted-research&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Hypothesis tree and research lineage.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="680" y="500" width="230" height="108" as="geometry"/></mxCell>
        <mxCell id="42" value="research" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="692" y="546" width="64" height="20" as="geometry"/></mxCell>
        <mxCell id="43" value="literature-discovery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="762" y="546" width="136" height="20" as="geometry"/></mxCell>
        <mxCell id="aw" value="&lt;b&gt;&lt;font color=&quot;#1B2A4A&quot;&gt;ai-assisted-work&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6a86&quot; face=&quot;Consolas&quot;&gt;dermot-obrien/ai-assisted-work&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#3a4a66&quot;&gt;Work items, activities, tasks, initiatives.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1B2A4A;strokeWidth=1.4;fontColor=#1B2A4A;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="925" y="500" width="140" height="108" as="geometry"/></mxCell>
        <mxCell id="45" value="work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FB;strokeColor=#1B2A4A;strokeWidth=1;fontColor=#1B2A4A;fontSize=11;fontFamily=Consolas;align=center;verticalAlign=middle;arcSize=20;spacing=0;" vertex="1" parent="1"><mxGeometry x="937" y="546" width="46" height="20" as="geometry"/></mxCell>
