        <mxCell id="id-provisioning" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1A1A2E;strokeColor=#2C3038;strokeWidth=2;fontFamily=Helvetica;fontColor=#FFFFFF;verticalAlign=top;spacingTop=10;spacingLeft=12;align=left;fontSize=11;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Identity Provisioning&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;border-color: #8D8D97;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Creates and manages identity objects for human and non-human actors. Assigns type, owner, sponsor, and lifecycle metadata.&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="230" x="47" y="100" as="geometry" />
        </mxCell>
        <mxCell id="cred-mgmt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#A5ADD4;strokeColor=#6B7280;strokeWidth=2;fontFamily=Helvetica;fontColor=#2C3038;verticalAlign=top;spacingTop=8;spacingLeft=12;align=left;fontSize=11;" value="&lt;b&gt;Credential Management&lt;/b&gt;&lt;hr style=&quot;border-color:#BFC5CC;&quot;&gt;&lt;font style=&quot;color: rgb(44, 48, 56);&quot;&gt;Issues, rotates, and revokes credentials. Enforces no-stored-secrets for workload identities.&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="230" x="47" y="218" as="geometry" />
        </mxCell>
        <mxCell id="id-decommission" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#A5ADD4;strokeColor=#6B7280;strokeWidth=2;fontFamily=Helvetica;fontColor=#2C3038;verticalAlign=top;spacingTop=8;spacingLeft=12;align=left;fontSize=11;" value="&lt;b&gt;Identity Decommissioning&lt;/b&gt;&lt;hr style=&quot;border-color:#BFC5CC;&quot;&gt;&lt;font style=&quot;color: rgb(44, 48, 56);&quot;&gt;Disables and removes identities at end of lifecycle. Automated expiry and attestation reviews.&lt;/font&gt;" vertex="1">
          <mxGeometry height="92" width="230" x="47" y="313" as="geometry" />
        </mxCell>
