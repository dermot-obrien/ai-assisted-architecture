        <mxCell id="token-issuance" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#1A1A2E;strokeColor=#2C3038;strokeWidth=2;fontFamily=Helvetica;fontColor=#FFFFFF;verticalAlign=top;spacingTop=10;spacingLeft=12;align=left;fontSize=11;" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Token Issuance&lt;/font&gt;&lt;/b&gt;&lt;hr style=&quot;border-color: #8D8D97;&quot;&gt;&lt;font style=&quot;color: rgb(255, 255, 255);&quot;&gt;Issues short-lived security tokens after successful authentication. Tokens carry identity claims, roles, and scopes.&lt;/font&gt;" vertex="1">
          <mxGeometry height="96" width="230" x="355" y="100" as="geometry" />
        </mxCell>
        <mxCell id="token-validation" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#A5ADD4;strokeColor=#6B7280;strokeWidth=2;fontFamily=Helvetica;fontColor=#2C3038;verticalAlign=top;spacingTop=8;spacingLeft=12;align=left;fontSize=11;" value="&lt;b&gt;Token Validation&lt;/b&gt;&lt;hr style=&quot;border-color:#BFC5CC;&quot;&gt;&lt;font style=&quot;color: rgb(44, 48, 56);&quot;&gt;Verifies token integrity, issuer trust, expiry, audience, and claim content on every request.&lt;/font&gt;" vertex="1">
          <mxGeometry height="83" width="230" x="355" y="216" as="geometry" />
        </mxCell>
