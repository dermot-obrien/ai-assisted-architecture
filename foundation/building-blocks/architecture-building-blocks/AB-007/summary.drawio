<mxfile host="Electron" version="29.5.2">
  <diagram id="ab-007-summary" name="AB-007 Summary Panel">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="960" pageHeight="1080" background="#FFFFFF" math="0" shadow="0">
      <root>
