{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sbb.schema.json",
  "title": "Solution Building Block (v1.1.0)",
  "description": "A concrete realisation of one or more ABBs using specific products/services (TOGAF). Realised at runtime by one or more Services.",
  "type": "object",

  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "kind": { "const": "sbb" },
        "id":   { "type": "string", "pattern": "^SB-\\d{3}$" },

        "realises":              { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/abbId" }, "minItems": 1, "uniqueItems": true },
        "realised_by_services":  { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/serviceId" }, "uniqueItems": true },

        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name":      { "type": "string", "minLength": 1 },
              "vendor":    { "type": "string" },
              "licensing": { "type": "string" }
            }
          }
        },

        "product_mapping": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["abb_component", "sbb_product"],
            "properties": {
              "abb_component": { "type": "string", "minLength": 1 },
              "sbb_product":   { "type": "string", "minLength": 1 },
              "notes":         { "type": "string" }
            }
          }
        },

        "cloud_provider":   { "type": "string", "enum": ["azure", "aws", "gcp", "onprem", "multi", "none"] },
        "variants":         { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "deployment_model": { "type": "string", "enum": ["managed", "self-hosted", "hybrid"] }
      },
      "required": ["realises", "products", "product_mapping"]
    }
  ]
}
