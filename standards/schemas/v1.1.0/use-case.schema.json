{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "use-case.schema.json",
  "title": "Use Case Artefact (v1.1.0)",
  "description": "An operational scenario describing how actors interact with the system to achieve an Outcome.",
  "type": "object",

  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "properties": {
        "kind": { "const": "use-case" },
        "id":   { "type": "string", "pattern": "^UC-\\d{3}$" },

        "primary_actor":    { "type": "string", "minLength": 1 },
        "secondary_actors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scenario":         { "type": "string", "minLength": 1 },
        "preconditions":    { "type": "array", "items": { "type": "string" } },
        "success_criteria": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "frequency":        { "type": "string", "enum": ["low", "medium", "high"] },
        "volume":           { "type": "string" },

        "supports_outcome":   { "$ref": "envelope.schema.json#/$defs/outcomeId" },
        "realised_by_abbs":   { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/abbId" }, "minItems": 1, "uniqueItems": true }
      },
      "required": ["primary_actor", "supports_outcome", "realised_by_abbs", "success_criteria"]
    }
  ]
}
